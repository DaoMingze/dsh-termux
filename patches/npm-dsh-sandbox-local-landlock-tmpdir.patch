diff --git a/dsh-sandbox-local/lib/index.js b/dsh-sandbox-local/lib/index.js
index 47c48dd..35f1b9f 100644
--- a/dsh-sandbox-local/lib/index.js
+++ b/dsh-sandbox-local/lib/index.js
@@ -48,4 +48,11 @@
+	// dsh-termux-landlock-tmpdir: Termux points TMPDIR at $PREFIX/tmp, a real
+	// directory distinct from the OS-owned /tmp the stock grant assumes; without
+	// os.tmpdir() in the readWrite list, workspace-write denies every
+	// mktemp-family call on Android. Rules bind to inodes at exec time, so the
+	// grant cannot be widened by env changes inside the sandbox. This push sits
+	// after the (version-specific) mode grant so one patch serves every shape.
+	if (policy.mode === "workspace-write") readWrite.push(tmpdir());
 	return grantArgs({
 		readOnly: ["/"],
 		readWrite
 	});
